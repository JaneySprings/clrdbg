<!-- ICorDebug-based managed debugger engine. Based on SharpDbg (https://github.com/MattParkerDev/sharpdbg, MIT), see ATTRIBUTION.md -->
<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Common.Build.props" />

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- The Roslyn expression compiler internals used by the expression evaluator -->
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis.CSharp" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis.ExpressionEvaluator.ExpressionCompiler" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="MP.Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" />
		<PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
		<PackageReference Include="Microsoft.Diagnostics.DbgShim" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DotNet.Debugging.CorApi\DotNet.Debugging.CorApi.csproj" />
	</ItemGroup>
</Project>
